# Example only. Copy to .env and edit. Never put real secrets or real data here.
API_PORT=8080
WEB_PORT=5173
# Web server -> Go API (server-side calls from SvelteKit)
API_INTERNAL_URL=http://localhost:8080
# Runtime role of the API (development value; created by `make db-init`)
DATABASE_URL=postgres://app:app@localhost:5432/bappelitbangda_dev?sslmode=disable
# Role that runs migrations (development value)
MIGRATE_URL=postgres://migrator:migrator@localhost:5432/bappelitbangda_dev?sslmode=disable
